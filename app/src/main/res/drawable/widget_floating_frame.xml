<?xml version="1.0" encoding="utf-8"?>
<!-- The outline of a widget without a background, as Music's: nothing to see, but a shape the launcher takes for the widget's own. A widget that names its background and clips to it is left alone, where otherwise the launcher cuts the whole widget to the system's rounded corners – and with them the badge on the corner and the corners of a frame or a strip. The rounding is the badge's (15 dp), the smallest of what reaches a corner. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="15dp" />
    <solid android:color="@android:color/transparent" />
</shape>
