<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed (owner's decision, 13 Nov 2026): old sites still publish their feeds without HTTPS. HTTPS is tried first for an address typed without a scheme. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
