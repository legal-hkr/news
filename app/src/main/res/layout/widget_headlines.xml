<?xml version="1.0" encoding="utf-8"?>
<!-- The Headlines widget (SPEC-widgets §6): the newest unread articles of the source as strips that scroll inside the widget, and the badge on the first strip's corner, which does not scroll. The list starts 8 dp from the start and 12 dp from the top, so the badge stays inside the widget's bounds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,UselessParent,ContentDescription,HardcodedText"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true">

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <include layout="@layout/widget_badge" />
</FrameLayout>
