<?xml version="1.0" encoding="utf-8"?>
<!-- The Newest article widget (SPEC-widgets §5) with a picture: one frame holding the oblong picture, which takes the height the caption leaves, the feed's name and the headline (up to 3 lines); the badge on its corner. The frame starts 8 dp from the start and 10 dp from the top, so the badge stays inside the widget's bounds. Sizes are in dp, text too. This copy is the widget picker's preview, with sample content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,UselessParent,ContentDescription,HardcodedText"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_frame"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/picture"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_picture"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/feed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Ars Technica"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="The quiet return of the personal website"
            android:textColor="@color/widget_on_surface"
            android:textSize="14dp" />
    </LinearLayout>

    <!-- The badge (§3.3, §3.4): the unread count of the source, not capped; it sticks out of the corner -->
    <LinearLayout
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_rss_feed"
            android:tint="@color/widget_inverse_on_surface"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/badge_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="37"
            android:textColor="@color/widget_inverse_on_surface"
            android:textSize="15dp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/badge_state"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_check"
            android:tint="@color/widget_inverse_on_surface"
            android:visibility="gone"
            tools:ignore="UseAppTint" />
    </LinearLayout>
</FrameLayout>
