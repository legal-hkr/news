<?xml version="1.0" encoding="utf-8"?>
<!-- The Newest article widget (SPEC-widgets §5) with a picture: one frame holding the oblong picture, which takes the height the caption leaves, the feed's name and the headline (up to 3 lines); the badge on its corner. The frame starts 8 dp from the start and 10 dp from the top, so the badge stays inside the widget's bounds. Sizes are in dp, text too. This copy is the widget picker's preview, with sample content. The content stands 8 dp inside the preview: the launcher's widget picker cuts every preview to its own rounded corners, also one that names its background and clips to it, and would cut the badge's corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,UselessParent,ContentDescription,HardcodedText"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_frame"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/picture"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_picture"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/feed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Ars Technica"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="The quiet return of the personal website"
            android:textColor="@color/widget_on_surface"
            android:textSize="14dp" />
    </LinearLayout>

    <include layout="@layout/widget_badge_sample" />
</FrameLayout>
