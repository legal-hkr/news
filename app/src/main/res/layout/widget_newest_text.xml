<?xml version="1.0" encoding="utf-8"?>
<!-- The Newest article widget for an article without a picture on the phone (SPEC-widgets §5): no picture box, the headline larger and up to 5 lines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,UselessParent,ContentDescription,HardcodedText"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_frame"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="26dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/feed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="5"
            android:textColor="@color/widget_on_surface"
            android:textSize="17dp" />
    </LinearLayout>

    <include layout="@layout/widget_badge" />
</FrameLayout>
