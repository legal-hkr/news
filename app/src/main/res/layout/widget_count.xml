<?xml version="1.0" encoding="utf-8"?>
<!-- The Count widget (SPEC-widgets §4): the pill alone, centered in its cell – the feed symbol and the unread count of the widget's source, or a double check (nothing unread) or a plus (no feeds yet) in the number's place. Sizes are in dp, text too: the widget lives in a fixed cell. Only the pill takes taps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,UselessParent,ContentDescription"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_pill"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_rss_feed"
            android:tint="@color/widget_inverse_on_surface"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_inverse_on_surface"
            android:textSize="18dp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/state"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_done_all_bold"
            android:tint="@color/widget_inverse_on_surface"
            android:visibility="gone"
            tools:ignore="UseAppTint" />
    </LinearLayout>
</FrameLayout>
