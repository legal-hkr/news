<?xml version="1.0" encoding="utf-8"?>
<!-- The Headlines widget's preview for the widget picker: three strips with sample content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,UselessParent,ContentDescription,HardcodedText"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/one"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/widget_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <!-- The thumbnail's place: a tile with a symbol, under the thumbnail when there is one -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_tile"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/one_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_rss_feed"
                    android:tint="@color/widget_on_surface_variant"
                    tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/one_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/one_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="The quiet return of the personal website"
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5dp" />

            <TextView
                android:id="@+id/one_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="13:40"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/two"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <!-- The thumbnail's place: a tile with a symbol, under the thumbnail when there is one -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_tile"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/two_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_rss_feed"
                    android:tint="@color/widget_on_surface_variant"
                    tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/two_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/two_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="A week with a feed reader and no algorithm"
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5dp" />

            <TextView
                android:id="@+id/two_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="12:58"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/three"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <!-- The thumbnail's place: a tile with a symbol, under the thumbnail when there is one -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_tile"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/three_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_rss_feed"
                    android:tint="@color/widget_on_surface_variant"
                    tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/three_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/three_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="Kernel development statistics for the last cycle"
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5dp" />

            <TextView
                android:id="@+id/three_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="11:12"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11dp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_badge_sample" />
</FrameLayout>
