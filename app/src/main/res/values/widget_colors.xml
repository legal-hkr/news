<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget colors (SPEC-widgets §3.1): the system's dynamic color roles, light here and dark in values-night. Home-screen widgets are drawn by the launcher from these resources; the app's own UI takes its colors in Compose. The system names no inverse roles, so those two are the tones M3 builds them from: neutral 20 and 95 in light, 90 and 20 in dark. -->
    <color name="widget_inverse_surface">@android:color/system_neutral1_800</color>
    <color name="widget_inverse_on_surface">@android:color/system_neutral1_50</color>
</resources>
