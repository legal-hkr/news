<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fetching the feeds the user subscribed to, their articles' pages and images; nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Telling "no network" from "the site did not answer". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The background refresh job stays scheduled across a restart of the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- One silent, optional notification that puts a badge on the app's icon (SPEC-widgets §8); asked for only when the user turns the badge on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No storage, media or location permission, ever. -->

    <application
        android:name=".NewsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.News">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <!-- Portrait only, as Music and Clock (SPEC §3.3) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" on a page in a browser: the address goes to Add a feed (SPEC §7.3) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (SPEC-widgets). Exported as the system requires: the launcher's widget service sends their updates. -->
        <receiver
            android:name=".widget.CountWidget"
            android:exported="true"
            android:label="@string/widget_count_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_count" />
        </receiver>
        <receiver
            android:name=".widget.NewestWidget"
            android:exported="true"
            android:label="@string/widget_newest_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_newest" />
        </receiver>
        <receiver
            android:name=".widget.HeadlinesWidget"
            android:exported="true"
            android:label="@string/widget_headlines_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The ages it shows ("14:20", "yesterday") belong to a time zone and a clock -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_headlines" />
        </receiver>
        <!-- The page that sets a widget's source, opened by the launcher through the system when a widget is placed or edited. -->
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.News"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The badge's notification was swiped away. -->
        <receiver
            android:name=".notify.BadgeDismissReceiver"
            android:exported="false" />

        <!-- Refresh in the background: run by the system's job scheduler only. -->
        <service
            android:name=".refresh.RefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Hands the image being shared from the viewer to the app the user picks; nothing else is reachable -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
