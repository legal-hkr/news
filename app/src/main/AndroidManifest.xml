<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fetching the feeds the user subscribed to, their articles' pages and images; nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Telling "no network" from "the site did not answer". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- No storage, media, location or notification permission, ever. -->

    <application
        android:name=".NewsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.News">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <!-- Portrait only, as Music and Clock (SPEC §3.3) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
